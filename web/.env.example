# Copy to .env.local. Public values are safe to expose; the rest stay on the server.

# "chain" (default) reads Arc testnet. "mock" uses in-memory demo data, for UI work only.
NEXT_PUBLIC_MODE=chain
NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io

# Written by `pnpm sync-addresses` from ../contracts/deployments/arc-testnet.json
NEXT_PUBLIC_FUND_REGISTRY=
NEXT_PUBLIC_NAV_ORACLE=
NEXT_PUBLIC_ISSUER_STUB=
NEXT_PUBLIC_CLAIM_TOKEN=
NEXT_PUBLIC_CLAIM_WRAPPER=
NEXT_PUBLIC_VAULT=

# Server only. Ops wallet: flips the stand-in issuer and allowlists demo visitors. Testnet funds only.
OPS_PRIVATE_KEY=
# Optional. If set, demo switches require this value in the x-demo-token header.
DEMO_TOKEN=

# Arkiv (server only)
ARKIV_ACCESS_KEY=
ARKIV_WRITER_PRIVATE_KEY=

# NAV pusher (server only). fund:feed pairs; the ACRED feed on Ethereum mainnet is 0x35DDfB90011E686CCf837a6819562705076207EB
FUND_FEEDS=
ETH_RPC=https://ethereum-rpc.publicnode.com
# Arc block of the deployment; the Arkiv indexer starts scanning here
ARC_DEPLOY_BLOCK=
# Optional. Protects /api/arkiv/sync and /api/nav/push when set (Vercel cron sends it as a bearer token)
CRON_SECRET=

# Arkiv writer wallet address; every Book read filters by it
ARKIV_WRITER_ADDRESS=0x343F684dAFFf216CDf38a40888662148eBa07Fd7
# Optional: require a key for Try as judge
JUDGE_TOKEN=
# Optional: server-side Arc RPC (defaults to NEXT_PUBLIC_ARC_RPC)
ARC_RPC=
